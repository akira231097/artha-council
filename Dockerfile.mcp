# Artha Council MCP. Runtime credentials are injected; never bake them in.
FROM python:3.12-slim

LABEL org.opencontainers.image.title="Artha Council MCP" \
      org.opencontainers.image.description="Auditable equity research, portfolio monitoring, and fail-closed broker execution over MCP" \
      org.opencontainers.image.source="https://github.com/akira231097/artha-council" \
      org.opencontainers.image.licenses="Apache-2.0" \
      io.modelcontextprotocol.server.name="io.github.akira231097/artha-council"

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    ARTHA_MCP_DATA_DIR=/var/lib/artha

WORKDIR /app

COPY pyproject.toml requirements.txt README.md LICENSE NOTICE package.json package-lock.json ./
COPY artha ./artha
COPY artha_mcp ./artha_mcp
COPY scripts ./scripts
COPY run.py ./run.py

RUN python -m pip install --upgrade pip \
    && python -m pip install . \
    && python -m compileall -q artha artha_mcp run.py \
    && addgroup --system artha \
    && adduser --system --ingroup artha --home /var/lib/artha artha \
    && mkdir -p /var/lib/artha \
    && chown -R artha:artha /var/lib/artha

USER artha
VOLUME ["/var/lib/artha"]

ENTRYPOINT ["artha-mcp"]
