# Copy this file to .env and add your own credentials.
# Never commit .env. Public defaults below cannot place live orders.

# Market and filing data
FMP_API_KEY=
MASSIVE_API_KEY=
FINNHUB_API_KEY=
BENZINGA_API_KEY=
FRED_API_KEY=
SEC_USER_AGENT=ArthaCouncil/1.0 (your-email@example.com)

# AI and web research
GOOGLE_API_KEY=
GEMINI_API_KEY=
BRAVE_SEARCH_API_KEY=
CODEX_AUTH_PATH=~/.codex/auth.json
ARTHA_GPT_MODEL=gpt-5.6-sol
ARTHA_GPT_FALLBACK_MODEL=gpt-5.6-terra
ARTHA_GPT_REASONING_EFFORT=xhigh
ARTHA_GPT_TEMPERATURE=0.2
ARTHA_GEMINI_TECHNICAL_MODEL=gemini-3.1-pro-preview
ARTHA_GEMINI_FLASH_MODEL=gemini-3.5-flash
ARTHA_GEMINI_THINKING_LEVEL=high
ARTHA_GEMINI_TEMPERATURE=0.3

# Optional Telegram delivery
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Broad scan and bounded agent controls
ARTHA_FMP_API_PLAN=premium
ARTHA_FMP_CALLS_PER_MINUTE=240
ARTHA_FUNNEL_RANK_TOP_N=150
ARTHA_FUNNEL_ENRICH_MAX=45
ARTHA_RANK_COVERAGE_AUDIT_ENABLED=true
ARTHA_SCAN_REQUIRE_MIN_RANK_COVERAGE=true
ARTHA_RANK_MIN_HISTORY_COVERAGE_PCT=0.90
ARTHA_ALPHA_SHADOW_SIGNALS_ENABLED=true
ARTHA_AGENTIC_COUNCIL_ENABLED=true
ARTHA_AGENTIC_WEB_RESEARCH_ENABLED=true
ARTHA_OPPORTUNITY_SCOUT_ENABLED=true
ARTHA_OPPORTUNITY_SCOUT_CANDIDATE_LIMIT=40
ARTHA_OPPORTUNITY_SCOUT_BATCH_SIZE=8
ARTHA_OPPORTUNITY_SCOUT_MAX_BATCHES=5

# Example portfolio policy. Adjust only after reading the implementation.
ARTHA_MONTHLY_BUDGET=350

# Robinhood/OpenClaw broker bridge
ARTHA_ROBINHOOD_MCP_URL=https://agent.robinhood.com/mcp/trading
ARTHA_ROBINHOOD_AGENTIC_ACCOUNT_NUMBER=
ARTHA_ROBINHOOD_EXPECTED_ACCOUNT_TYPE=cash
ARTHA_ROBINHOOD_EXPECTED_ACCOUNT_NICKNAME=Agentic
ARTHA_OPENCLAW_TMP_DIR=~/.openclaw/workspace/tmp

# Safe public defaults. All five must be deliberately changed before any live
# deployment can reach a placement path.
ARTHA_ROBINHOOD_REVIEW_ONLY=true
ARTHA_ROBINHOOD_DRY_RUN_ONLY=true
ARTHA_ROBINHOOD_AGENTIC_ENABLED=false
ARTHA_ROBINHOOD_AUTO_BUY_ENABLED=false
ARTHA_ROBINHOOD_AUTO_SELL_ENABLED=false
ARTHA_ROBINHOOD_KILL_SWITCH=true

# Example guardrails
ARTHA_ROBINHOOD_PILOT_MAX_ACCOUNT_VALUE=350
ARTHA_ROBINHOOD_MAX_POSITION_DOLLARS=50
ARTHA_ROBINHOOD_MAX_TRADES_PER_DAY=5
ARTHA_ROBINHOOD_MAX_SPREAD_PCT=0.01
ARTHA_ROBINHOOD_MIN_DOLLAR_VOLUME=10000000
ARTHA_ROBINHOOD_RECONCILIATION_SNAPSHOT_MAX_AGE_MINUTES=10
ARTHA_ROBINHOOD_AUTO_BUY_MAX_ORDER_DOLLARS=25
ARTHA_ROBINHOOD_AUTO_BUY_MAX_DAILY_DOLLARS=50
ARTHA_ROBINHOOD_AUTO_BUY_MIN_SCORE=70
ARTHA_SELL_LEARNING_MIN_COMPLETED=20

# Artha MCP server
# Default mode is local stdio, read-only, and unable to place an order.
ARTHA_MCP_TRANSPORT=stdio
ARTHA_MCP_HOST=127.0.0.1
ARTHA_MCP_PORT=8765
ARTHA_MCP_HTTP_PATH=/mcp
ARTHA_MCP_ALLOWED_HOSTS=127.0.0.1,localhost
ARTHA_MCP_ALLOWED_ORIGINS=
ARTHA_MCP_ACCESS_MODE=read_only
ARTHA_MCP_OPERATIONS_ENABLED=false
ARTHA_MCP_TRADING_ENABLED=false
ARTHA_MCP_KILL_SWITCH=true
ARTHA_MCP_MARKET=US
ARTHA_MCP_BROKER=snapshot
ARTHA_MCP_BROKER_PLUGIN=
ARTHA_MCP_RESEARCH_MODE=embedded
ARTHA_MCP_RESEARCH_PLUGIN=
ARTHA_MCP_NOTIFICATION=telegram
# Optional. When omitted, safe defaults are market-aware: US uses $25/$50;
# India uses INR 2,500/5,000. Values are always in the market currency.
# ARTHA_MCP_MAX_ORDER_VALUE=25
# ARTHA_MCP_MAX_DAILY_ORDER_VALUE=50
ARTHA_MCP_MAX_DAILY_ORDERS=2
ARTHA_MCP_MAX_SPREAD_PCT=0.01
ARTHA_MCP_QUOTE_MAX_AGE_SECONDS=30
ARTHA_MCP_WORKFLOW_TIMEOUT_SECONDS=10800
ARTHA_MCP_MAX_PENDING_JOBS=8

# Required for any non-loopback Streamable HTTP deployment. Terminate TLS at
# a trusted reverse proxy and provide JWT issuer metadata for this resource.
ARTHA_MCP_OAUTH_ISSUER=
ARTHA_MCP_OAUTH_RESOURCE_URL=
ARTHA_MCP_OAUTH_AUDIENCE=
ARTHA_MCP_OAUTH_JWKS_URL=
ARTHA_MCP_OAUTH_ALGORITHMS=RS256,ES256

# Indian cash-equity broker adapters. Select market=IN and one broker. Artha
# never guesses an Upstox instrument key. Indian live API placement also needs
# a static IP registered with the selected broker. Set the attestation only
# after the broker registration is complete.
ARTHA_INDIA_STATIC_IP_REGISTERED=false
# Set true only after durable DDPI/POA is active, or while a current-session
# depository authorization is valid. The broker remains authoritative.
ARTHA_INDIA_DEMAT_SELL_AUTHORIZED=false
UPSTOX_ACCESS_TOKEN=
# Sandbox tokens are valid only for sandbox order endpoints. Keep the normal
# token above for account/quote/preview reads and use the separate token below
# only when ARTHA_UPSTOX_SANDBOX=true.
UPSTOX_SANDBOX_ACCESS_TOKEN=
ARTHA_UPSTOX_BASE_URL=https://api.upstox.com
ARTHA_UPSTOX_ORDER_BASE_URL=https://api-hft.upstox.com
ARTHA_UPSTOX_SANDBOX=false
# Optional; use only for an exchange-approved algo name configured in Upstox.
ARTHA_UPSTOX_ALGO_NAME=
KITE_API_KEY=
KITE_ACCESS_TOKEN=
ARTHA_ZERODHA_BASE_URL=https://api.kite.trade

# Optional HTTPS notification webhook. Used only when notification=webhook.
ARTHA_MCP_NOTIFICATION_WEBHOOK_URL=
ARTHA_MCP_NOTIFICATION_WEBHOOK_TOKEN=
# Optional portable runtime locations. Source checkouts default to ./data;
# installed wheels use the operating system's user-data directory.
ARTHA_ROOT=
ARTHA_DATA_DIR=
ARTHA_ENV_FILE=
